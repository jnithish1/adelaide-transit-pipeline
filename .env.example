# Copy to .env and fill in. .env is git-ignored - never commit it.

# --- AWS / landing zone ---------------------------------------------------
# Leave S3_BUCKET empty to write to ./data_lake locally instead (no AWS needed).
S3_BUCKET=
AWS_REGION=ap-southeast-2
# Only for running locally / in Airflow. GitHub Actions uses OIDC instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Snowflake (key-pair auth) ---------------------------------------------
# Account identifier, e.g. abc12345.ap-southeast-2 or ORGNAME-ACCOUNTNAME
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_TRANSIT_PIPELINE
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSIT_WH
SNOWFLAKE_DATABASE=TRANSIT

# --- dbt ---------------------------------------------------------------------
DBT_TARGET=dev
DBT_USER=nithish

# --- Sources (defaults are fine; override if the providers move them)
# GTFS_STATIC_URL=https://gtfs.adelaidemetro.com.au/v1/static/latest/google_transit.zip
# GTFS_RT_TRIP_UPDATES_URL=https://gtfs.adelaidemetro.com.au/v1/realtime/trip_updates
# WEATHER_LAT=-34.9285
# WEATHER_LON=138.6007
