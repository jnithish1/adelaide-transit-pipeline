{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadRaw",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<YOUR_BUCKET>/raw/*"
    },
    {
      "Sid": "ListBucketSoMissingFilesReturn404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET>"
    }
  ]
}
