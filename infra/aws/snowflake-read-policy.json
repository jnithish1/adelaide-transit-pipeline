{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::<YOUR_BUCKET>/raw/*"
    },
    {
      "Sid": "ListRawPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<YOUR_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["raw/*"] } }
    }
  ]
}
